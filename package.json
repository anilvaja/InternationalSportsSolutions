{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "server:dev": "node --watch server.js",
        "seed": "node src/db/seed.js",
        "migrate": "node scripts/run_migrations.js",
        "test": "node --test --test-concurrency=1 tests/Unit/**/*.test.js tests/Unit/**/*.test.mjs",
        "mobile:start": "npm --prefix mobile run start",
        "mobile:android": "npm --prefix mobile run android",
        "mobile:web": "npm --prefix mobile run web",
        "push:ftp": "powershell -ExecutionPolicy Bypass -File scripts/local_ftp_push.ps1",
        "push:ftp:full": "powershell -ExecutionPolicy Bypass -File scripts/local_ftp_push.ps1 -FullUpload",
        "build": "vite build",
        "dev": "vite",
        "test:ui": "node scripts/open_ui_test_runner.js",
        "test:ui:headless": "node scripts/open_ui_test_runner.js --headless",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:visual": "playwright test --headed",
        "test:visual": "node scripts/run_visual_headed_test.js",
        "test:visual:payroll": "node scripts/run_attendance_payroll_visual_test.js",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.12",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "puppeteer-core": "^25.3.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^11.10.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "jsonwebtoken": "^9.0.3",
        "multer": "^1.4.5-lts.2",
        "sharp": "^0.35.5"
    },
    "allowScripts": {
        "better-sqlite3@11.10.0": true
    }
}
