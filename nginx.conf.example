# Nginx Reverse Proxy Configuration Template
# Place in /etc/nginx/sites-available/iss-sports.conf

upstream iss_backend {
    server 127.0.0.1:3005;
    keepalive 32;
}

server {
    listen 80;
    server_name sports.example.com *.sports.example.com;

    # Maximum file upload size for bills and photos
    client_max_body_size 25M;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;

    # Serve static files directly
    location /storage/ {
        alias /var/www/iss-sports/storage/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location / {
        proxy_pass http://iss_backend;
        proxy_http_version 1.1;

        # WebSocket & connection upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # Host & client IP forwarding
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
